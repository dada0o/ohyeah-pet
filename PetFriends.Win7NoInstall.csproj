<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net35</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);NET35</DefineConstants>
    <ApplicationIcon>Assets\pet.ico</ApplicationIcon>
    <AssemblyName>小欧公爵和小耶牧师桌宠-Win7免安装版</AssemblyName>
    <RootNamespace>PetFriends</RootNamespace>
    <Version>1.2.0</Version>
    <StartupObject>PetFriends.Program</StartupObject>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;PetFriends.Mac\**</DefaultItemExcludes>
    <AppConfig>App.Win7NoInstall.config</AppConfig>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>false</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Compile Remove="App.xaml.cs;AutostartService.cs;Compat.cs;PetWindow.cs;CuddleWindow.cs;PetWorld.cs;RuntimeLog.cs" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net35" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cat.png" />
    <Resource Include="Assets\dog.png" />
    <Resource Include="Assets\cuddle.png" />
  </ItemGroup>
</Project>
